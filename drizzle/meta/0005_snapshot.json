          "value": "(\"tasks\".\"status\" in ('picked_up', 'completed', 'invoiced')) = (\"tasks\".\"picked_up_at\" is not null)"
        },
        "tasks_invoiced_matches_status": {
          "name": "tasks_invoiced_matches_status",
          "value": "(\"tasks\".\"status\" = 'invoiced') = (\"tasks\".\"invoiced_at\" is not null)\n        and (\"tasks\".\"status\" = 'invoiced') = (\"tasks\".\"invoiced_by\" is not null)"
        },
        "tasks_cancelled_matches_status": {
          "name": "tasks_cancelled_matches_status",
          "value": "(\"tasks\".\"status\" = 'cancelled') = (\"tasks\".\"cancelled_at\" is not null)\n        and (\"tasks\".\"status\" = 'cancelled') = (\"tasks\".\"cancelled_by\" is not null)"
        },
        "tasks_cancellation_reason_valid": {
          "name": "tasks_cancellation_reason_valid",
          "value": "\"tasks\".\"cancellation_reason\" is null\n        or (\"tasks\".\"status\" = 'cancelled' and char_length(\"tasks\".\"cancellation_reason\") <= 500)"
        },
