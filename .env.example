# Copy this file to `.env.local` and fill in the values.
# `.env.local` is never committed. This file contains names only, never values.

# Supabase (Project Settings > API Keys). Local Supabase: run `supabase status -o env`.
# Public: may be used in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret: server-side only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional, only for `pnpm seed:backoffice`: password of the first backoffice user
# (at least 12 characters). Left empty, the script generates one and prints it once.
SEED_BACKOFFICE_PASSWORD=

# PostgreSQL connection string, used server-side by Drizzle (`src/db/client.ts`)
# and by `pnpm db:migrate`. Never prefix with NEXT_PUBLIC_.
# Local Supabase: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# Optional, only for `pnpm test:e2e`: password of the test users that the end-to-end tests
# create in the local Supabase. Has a default in e2e/support/test-users.ts; never use a real password.
E2E_TEST_PASSWORD=
