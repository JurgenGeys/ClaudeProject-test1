# Copy this file to `.env.local` and fill in the values.
# `.env.local` is never committed. This file contains names only, never values.

# Supabase (Project Settings > API). Not used yet.
# Public: may be used in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret: server-side only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# PostgreSQL connection string, used server-side by Drizzle (`src/db/client.ts`)
# and by `pnpm db:migrate`. Never prefix with NEXT_PUBLIC_.
# Local Supabase: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
